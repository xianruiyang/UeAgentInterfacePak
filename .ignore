# Parent-repository discovery boundaries. Enter each nested owner explicitly.
/.git/
/UeAgentInterface/
/UeAgentInterfaceCMD/
/skills/kbcli-knowledge-base/

# Historical evidence is opt-in, not part of ordinary current-source discovery.
/retired/strict_v2/

