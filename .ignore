# Use an explicit path or --no-ignore when maintaining the payload itself.
/skills/ue-kb/chunks/
/skills/ue-kb/content/
/skills/ue-kb/data/
/skills/ue-kb/indexes/
/skills/ue-kb/references/
/skills/ue-kb/state/

# Embedded Niagara knowledge uses its own SKILL.md and manifest entry.
/skills/ue-agent-interface/knowledge/niagara-bplus/chunks/
/skills/ue-agent-interface/knowledge/niagara-bplus/content/
/skills/ue-agent-interface/knowledge/niagara-bplus/data/
